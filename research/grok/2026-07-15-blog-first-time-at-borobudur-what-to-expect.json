emple structure access via timed slots starting 08:30.\",\n      \"source_name\": \"travel-lush.com\",\n      \"url\": \"https://travel-lush.com/borobudur-temple/\",\n      \"date\": \"2026\"\n    },\n    {\n      \"fact\": \"Temple structure ticket includes mandatory 1.5-hour guided session with certified local guide.\",\n      \"source_name\": \"borobudurtemple.org\",\n      \"url\": \"https://borobudurtemple.org/hours-and-fees/\",\n      \"date\": \"2026\"\n    }\n  ]\n}","logprobs":[],"annotations":[{"type":"url_citation","url":"https://borobudurtemple.org/hours-and-fees/","start_index":0,"end_index":0,"title":"https://borobudurtemple.org/hours-and-fees/"},{"type":"url_citation","url":"https://unimma.press/conference/index.php/bishss/article/view/272","start_index":0,"end_index":0,"title":"https://unimma.press/conference/index.php/bishss/article/view/272"},{"type":"url_citation","url":"https://www.mdpi.com/2571-9408/8/2/77","start_index":0,"end_index":0,"title":"https://www.mdpi.com/2571-9408/8/2/77"},{"type":"url_citation","url":"https://www.yogya-backpacker.com/borobudur-temple/","start_index":0,"end_index":0,"title":"https://www.yogya-backpacker.com/borobudur-temple/"},{"type":"url_citation","url":"https://en.tempo.co/read/1554560/upanat-sandals-special-footwear-to-visit-borobudur-temple","start_index":0,"end_index":0,"title":"https://en.tempo.co/read/1554560/upanat-sandals-special-footwear-to-visit-borobudur-temple"},{"type":"url_citation","url":"https://destinasian.com/editorial/the-other-side-of-borobudur","start_index":0,"end_index":0,"title":"https://destinasian.com/editorial/the-other-side-of-borobudur"},{"type":"url_citation","url":"https://panoramalenstrip.com/borobudur-temple-climb-rules-tickets/#:~:text=Mandatory%20Upanat%20sandals%20are%20required,value%20beyond%20the%20climb%20itself.","start_index":0,"end_index":0,"title":"https://panoramalenstrip.com/borobudur-temple-climb-rules-tickets/#:~:text=Mandatory%20Upanat%20sandals%20are%20required,valu