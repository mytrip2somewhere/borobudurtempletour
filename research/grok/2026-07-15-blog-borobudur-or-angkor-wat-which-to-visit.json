ytours.com/blog/angkor-wat-tickets/\",\n      \"date\": \"2025\"\n    },\n    {\n      \"fact\": \"Borobudur Temple had approximately 1.3 million visitors in 2024.\",\n      \"source_name\": \"ANTARA News\",\n      \"url\": \"https://en.antaranews.com/news/339854/indonesias-borobudur-temple-targets-17-million-visitors-in-2025\",\n      \"date\": \"2024\"\n    }\n  ]\n}","logprobs":[],"annotations":[{"type":"url_citation","url":"https://www.angkorenterprise.gov.kh/en","start_index":0,"end_index":0,"title":"https://www.angkorenterprise.gov.kh/en"},{"type":"url_citation","url":"https://construction-property.com/cambodia-records-44-million-in-annual-revenue-from-angkor-archaeological-park-tourism/","start_index":0,"end_index":0,"title":"https://construction-property.com/cambodia-records-44-million-in-annual-revenue-from-angkor-archaeological-park-tourism/"},{"type":"url_citation","url":"https://www.aseanangkorguide.com/travel-information/angkor-wat-entrance-ticket/","start_index":0,"end_index":0,"title":"https://www.aseanangkorguide.com/travel-information/angkor-wat-entrance-ticket/"},{"type":"url_citation","url":"https://cambodianess.com/article/international-tourists-visiting-angkor-down-347-in-11-months-of-2025","start_index":0,"end_index":0,"title":"https://cambodianess.com/article/international-tourists-visiting-angkor-down-347-in-11-months-of-2025"},{"type":"url_citation","url":"https://kiripost.com/stories/angkor-wat-loses-ground-as-cambodia-sees-record-tourist-numbers","start_index":0,"end_index":0,"title":"https://kiripost.com/stories/angkor-wat-loses-ground-as-cambodia-sees-record-tourist-numbers"},{"type":"url_citation","url":"https://www.angkorphotographytours.com/blog/angkor-wat-tickets/","start_index":0,"end_index":0,"title":"https://www.angkorphotographytours.com/blog/angkor-wat-tickets/"},{"type":"url_citation","url":"https://en.antaranews.com/news/339854/indonesias-borobudur-temple-targets-17-million-visitors-in-2025","start_index":0,"end_index":0,"titl